/** Тексты статей держат тот же порог машинности, что и тексты бота. */
function verify(articles: readonly Article[]): readonly string[] {
  const complaints: string[] = [];
  for (const article of articles) {
    for (const complaint of slopComplaints(article.body)) {
      complaints.push(`«${article.title}»: ${complaint}`);
    }
    if (TIME_UNIT.test(article.body)) {
      complaints.push(`«${article.title}»: единица времени разоружает заставу сроков`);
    }
  }
  return complaints;
}

async function main(): Promise<void> {
  const url = process.env.DATABASE_URL;
  if (!url) {
    console.error('Не задан DATABASE_URL');
    process.exitCode = 1;
    return;
  }

  const broken = verify(ARTICLES);
  if (broken.length > 0) {
    for (const complaint of broken) console.error(complaint);
    process.exitCode = 1;
    return;
  }

  const db = createDatabase(url);
  try {
    const existing = await db
      .select({ title: conciergeKnowledge.title })
      .from(conciergeKnowledge);
    const taken = new Set(existing.map((one) => one.title));

    for (const article of ARTICLES) {
      if (taken.has(article.title)) {
        console.log(`«${article.title}» уже есть — не тронута`);
        continue;
      }
      await db.insert(conciergeKnowledge).values(article);
      console.log(`«${article.title}» заведена`);
    }

    console.log(
      'Готово. Статьи правятся в панели: настройки → база знаний. ' +
        'График работы и банки туда же — их в репозитории нет.',
    );
  } finally {
    await db.$client.end();
  }
}

await main();
