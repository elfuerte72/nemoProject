import { createDatabase, slopComplaints, TIME_UNIT } from '@nemo/core';
import { conciergeKnowledge } from '@nemo/db';

/**
 * Наполнить базу знаний консьержа тем, что о сервисе уже записано, — в
 * документации и в коде. До сих пор база была пуста, и на всё, чего нет
 * в курсах и заявках клиента, помощник звал менеджера.
 *
 * Скрипт, а не правка руками через панель: факты собраны из репозитория
 * (CONTEXT.md, ADR, справочники), и заносить их по одному — значит
 * перепечатывать. Дальше статьи живут как данные администратора: он
 * правит их из панели в тот день, когда факт меняется.
 *
 * Поэтому повторный прогон ничего не затирает: статья с уже занятым
 * названием пропускается — в ней могут стоять правки администратора, и
 * прогон скрипта не повод отменять их молча. Погашенная статья по той же
 * причине не воскрешается. Чистый повтор сида — это удалить статью в
 * базе и прогнать скрипт снова.
 *
 * Чего в статьях не бывает намеренно:
 * - чисел, которые задаются настройками или меняются рынком (минималка,
 *   наценка, курс): они приходят в справку живыми, а записанные здесь
 *   успели бы соврать;
 * - единиц времени: по ним застава решает, называл ли сервис сроки, и
 *   одно слово «час» в статье разоружило бы запрет на обещание сроков;
 * - внутренней кухни — провайдеров, панели, устройства репо: статья
 *   уходит модели, а через её пересказ — клиенту.
 *
 * Запуск: pnpm seed-concierge-knowledge
 */

interface Article {
  readonly title: string;
  readonly body: string;
  /** Порядок в справке: наверху то, о чём спрашивают чаще. */
