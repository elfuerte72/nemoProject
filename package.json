{
  "name": "nemo",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:generate": "pnpm --filter @nemo/db generate",
    "db:migrate": "pnpm --filter @nemo/db migrate",
    "db:studio": "pnpm --filter @nemo/db studio"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "turbo": "^2.9.14",
    "typescript": "^5.6.0"
  }
}
