# Образ кабинета мерчанта: сайт с почтой и паролем и API мерчанта `/api/v1`.
#
# Контекст сборки — корень монорепо, как у остальных двух: приложение
# зависит от пакетов рабочего пространства, а договор API
# (`docs/api/merchant-v1.yaml`) едет в бандл строкой из того же корня.
#
# Контур клиентский: приватного ключа расшифровки реквизитов здесь нет
# и быть не должно (docs/adr/0002) — кабинет реквизиты только шифрует,
# показывает их менеджер из панели. Миграции этот образ не применяет:
# владелец схемы один, и это панель (см. docker/admin.Dockerfile).
#
# Внутри процесса живёт воркер вебхуков (docs/adr/0018): доставки идут,
# только пока кабинет поднят, и планировщик им не нужен. Планировщик
# нужен журналу вызовов API — суточный вызов чистки из Schedules, как
# у служебных маршрутов соседей (README, «Развёртывание»).
#
# Про отсутствие самодостаточной сборки — см. docker/miniapp.Dockerfile.

FROM node:22-alpine
RUN corepack enable
WORKDIR /app

COPY --chown=node:node . .

# Про corepack и владельца каталога — см. docker/miniapp.Dockerfile.
RUN corepack install
RUN chown node:node /app

USER node
RUN pnpm install --frozen-lockfile

# Аргументов сборки у кабинета нет: `NEXT_PUBLIC_*` он не читает, и всё,
# что ему нужно, приходит переменными контейнера при запуске. На сборке
# вшивается только коммит — `APP_VERSION` из next.config.ts.
RUN pnpm --filter @nemo/cabinet build

ENV NODE_ENV=production
# В разработке кабинет слушает 3002, чтобы не спорить с Mini App и
# панелью на одной машине; в контейнере он один, и порт тот же, что у
# остальных образов, — домен в Dokploy заводится на него.
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

EXPOSE 3000
CMD ["pnpm", "--filter", "@nemo/cabinet", "start"]
