# Образ клиентского приложения: Mini App и вебхук бота.
#
# Контекст сборки — корень монорепо, а не каталог приложения: оно
# зависит от пакетов рабочего пространства, и без их исходников
# установка не пройдёт.
#
# Приватного ключа расшифровки реквизитов в этом образе быть не должно
# (docs/adr/0002) — он передаётся только в деплой админ-панели.
#
# Образ несёт рабочее пространство целиком, а не самодостаточную сборку
# Next: драйвер базы объявлен внешним пакетом и в такую сборку не
# попадает — приложение падало бы на первом обращении к базе. Образ от
# этого крупнее, но работает.

FROM node:22-alpine
RUN corepack enable
WORKDIR /app

# Владелец — пользователь `node` из базового образа: приложение
# принимает запросы из сети, и права root ему для этого не нужны.
COPY --chown=node:node . .

# Менеджер пакетов скачивается заранее и от root: corepack кладёт его в
# общий каталог, куда `node` записать не может. Версия берётся из
# package.json — повторять её здесь значило бы однажды разойтись.
RUN corepack install
# Сам каталог создан root'ом, а установка пишет в него временные файлы.
RUN chown node:node /app

USER node
RUN pnpm install --frozen-lockfile

# Имя бота нужно на сборке, а не в запуске: из него собирается
# реферальная ссылка в браузере, а всё `NEXT_PUBLIC_*` Next подставляет
# в клиентский код в момент сборки. Переданное только переменной
# окружения контейнера сюда уже не попадёт.
ARG NEXT_PUBLIC_TELEGRAM_BOT_USERNAME
ENV NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=$NEXT_PUBLIC_TELEGRAM_BOT_USERNAME

RUN pnpm --filter @nemo/miniapp build

# После сборки: до неё Next и TypeScript нужны как есть, а `production`
# отсекал бы установку зависимостей разработки.
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

EXPOSE 3000
CMD ["pnpm", "--filter", "@nemo/miniapp", "start"]
