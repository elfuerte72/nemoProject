# База. В разработке — локальный Postgres; выбор хостинга для прода
# отложен до ответа на блокер A1 (юрисдикция определяет, где законно
# держать персональные данные).
DATABASE_URL=postgres://nemo:nemo@localhost:5432/nemo_dev
# Базовое имя тестовых баз. Данные между тестами вычищаются, поэтому они
# отдельные от базы разработки; к имени добавляется суффикс пакета
# (nemo_test_core, nemo_test_db), и такая база создаётся сама.
TEST_DATABASE_URL=postgres://nemo:nemo@localhost:5432/nemo_test

# Telegram. Ботов два, зачем — в docs/adr/0005.
#
# Клиентский: его запускают покупатели, через него уходят уведомления о
# заявках. Нужен обоим деплоям — клиентскому принимать обновления,
# админке отправлять сообщения.
TELEGRAM_BOT_TOKEN=
# Секрет вебхука клиентского бота. Передаётся в setWebhook параметром
# secret_token и проверяется в apps/miniapp/app/api/bot/route.ts.
TELEGRAM_WEBHOOK_SECRET=
# Адрес Mini App — на него ведёт кнопка в боте.
MINIAPP_URL=https://example.com
# Секрет служебных вызовов планировщика. Задаётся обоим приложениям:
# клиентскому — для POST /api/exchange-requests/deadlines (срок оплаты)
# и POST /api/concierge/pending (ответы помощника, не дошедшие из-за
# выкатки или падения обработчика);
# админке — для POST /api/staff/notify (обращения, новые заявки и
# напоминания о том, что залежалось).
# Планировщик дёргает их раз в несколько минут с заголовком
# `authorization: Bearer <секрет>`. Без него маршруты отвечают отказом:
# неоплаченные заявки не отменяются, а сотрудники не узнают о вопросах.
#
# Тем же секретом клиентское приложение стучится в /api/staff/notify
# сразу после события — чтобы менеджер узнал о нём через секунду, а не
# через период расписания. Значение у обоих деплоев одно.
SCHEDULER_SECRET=
# Имя бота для виджета Telegram Login в админке. Домен админки должен
# быть привязан к боту через /setdomain у BotFather, иначе виджет
# откажется работать.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Токен бота, чей виджет показывает кнопку входа в админку
# (docs/adr/0005). Отдельный от клиентского: клиентский токен по
# необходимости лежит в обоих деплоях, и подписывать им вход значило бы
# отдавать первый фактор вместе с утечкой клиентского контура.
# TELEGRAM_BOT_TOKEN при этом остаётся клиентским — им админка
# отправляет уведомления, и уйти они должны от бота, которого клиент
# запускал. Не задан — используется клиентский.
ADMIN_LOGIN_BOT_TOKEN=
# Адрес админ-панели. Нужен обоим деплоям, но по разным поводам.
#
# Админке: бот входа отвечает им на /start — молчащий бот выглядит
# сломанным, и в нём начинают искать саму админку. Он же становится
# кнопкой «Открыть в панели» под уведомлением сотруднику.
#
# Клиентскому: по нему оно стучится в /api/staff/notify сразу после
# нового обращения или заявки. Не задан — повод доедет до менеджера
# следующим прогоном планировщика, то есть через минуты.
ADMIN_URL=
# Секрет вебхука бота входа. Отдельный от клиентского: боты разные, и
# общий секрет связал бы их обратно.
ADMIN_BOT_WEBHOOK_SECRET=

# Подпись сессии админ-панели. Не короче 32 символов: подписью
# удостоверяется, что вход состоялся и не истёк.
ADMIN_SESSION_SECRET=

# Шифрование реквизитов (docs/adr/0002). Пару выпускает
# pnpm generate-keys.
#
# Ключ принимается и целым PEM, и одним телом base64 без строк
# -----BEGIN...-----: переменные окружения почти везде однострочные, и
# при переносе обрамление теряют.
#
# Публичный ключ — в оба деплоя: он только шифрует.
REQUISITES_PUBLIC_KEY=
# Приватный ключ — ТОЛЬКО в деплой админки. В клиентском приложении
# его быть не должно.
REQUISITES_PRIVATE_KEY=

# AI-консьерж. Провайдер — DeepSeek; используется его Anthropic-совместимый
# эндпоинт, поэтому клиент Anthropic SDK работает без изменений, но ключ и
# адрес передаются в него явно, а не через переменные с именем провайдера SDK.
#
# Нужен только клиентскому деплою: разговор ведёт бот, которого клиент
# запускал, а он живёт там. Ключа нет — нет и первой линии: клиенту
# отвечает менеджер, как было до консьержа. Это рабочее состояние, и
# снятием ключа консьерж выключается целиком.
#
# Быстрее ключа его выключают пределы ответов в настройках сервиса: их
# правит администратор из панели, не трогая выкатку.
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_API_KEY=
# Имя модели у провайдера. Свойство развёртывания: провайдер
# переименовывает модели чаще, чем выходит выкатка.
DEEPSEEK_MODEL=deepseek-chat

# Котировки валютных пар для электронных переводов. Необязателен:
# публичный список Rapira отдаётся и без ключа, а отсутствие курса —
# рабочее состояние, при котором заявку всё равно можно подать.
RAPIRA_KEY=

# Вход в панель по Telegram ID, без подписи Telegram и без одноразового
# кода. Нужен на своей машине: виджет Telegram Login требует настоящий
# домен, привязанный к боту, и на localhost отвечает «Bot domain
# invalid» — то есть панель локально не открывается вовсе.
#
# Проверка «сотрудник ли это» при этом остаётся: войти можно только тем,
# кто заведён, действует и кому выдан ключ.
#
# На сервере не заводить. Даже заведённая, переменная там не работает —
# вход требует ещё и сборки для разработки, — но её присутствие в
# окружении прода вводит в заблуждение.
# ADMIN_DEV_LOGIN=1
