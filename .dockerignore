# Что не должно попасть в контекст сборки.
#
# node_modules — прежде всего: они собраны под машину разработчика и в
# образе для другой архитектуры не заработают, а контекст раздувают на
# сотни мегабайт. Установка внутри образа идёт заново по локфайлу.
node_modules
**/node_modules

.next
**/.next
**/*.tsbuildinfo

.git
.github

# Секреты. В образ они попадают переменными окружения, а не файлом:
# слой с ключом расшифровки реквизитов остался бы в образе навсегда.
.env
.env.*
!.env.example

.scratch
.claude
